{
  "formatVersion": 1,
  "meta": { "name": "Plugin", "appVersion": "0.1.0" },
  "canvas": { "width": 128, "height": 128 },
  "nodes": [
    { "id": "photo", "type": "core.image", "position": { "x": 0, "y": 0 }, "params": { "asset": "input" } },
    { "id": "lines", "type": "plugin.scanlines.scanlines", "position": { "x": 240, "y": 0 }, "params": { "spacing": 3, "darkness": 0.6 } },
    { "id": "out", "type": "core.output", "position": { "x": 480, "y": 0 } }
  ],
  "links": [
    { "from": { "node": "photo", "port": "image" }, "to": { "node": "lines", "port": "image" } },
    { "from": { "node": "lines", "port": "image" }, "to": { "node": "out", "port": "image" } }
  ],
  "assets": [{ "id": "input", "path": "input.png", "kind": "image" }],
  "plugins": [{ "id": "scanlines", "version": "1.0.0", "path": "plugins/scanlines.js" }]
}
