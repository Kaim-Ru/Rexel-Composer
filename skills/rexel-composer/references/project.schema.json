{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "appVersion": {
          "type": "string"
        }
      },
      "required": ["name", "appVersion"],
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "params": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["id", "type", "position"],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "port": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": ["node", "port"],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "port": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": ["node", "port"],
            "additionalProperties": false
          }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["image", "palette"]
          }
        },
        "required": ["id", "path", "kind"],
        "additionalProperties": false
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "version": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": ["id", "version", "path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["formatVersion", "meta", "canvas", "nodes", "links", "assets", "plugins"],
  "additionalProperties": false
}
